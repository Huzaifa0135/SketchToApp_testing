# GEMINI_API_KEY: Required for Gemini AI design analysis & assistant calls when running without a deployed backend URL.
# Configure securely via the Secrets panel in AI Studio. Never commit actual keys.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIGMA_ACCESS_TOKEN: Optional token for authenticated Figma REST API file & frame imports in prototype/dev mode.
# In production deployments, configure Figma OAuth on the backend service instead.
FIGMA_ACCESS_TOKEN=YOUR_FIGMA_ACCESS_TOKEN

# BACKEND_API_URL: Optional HTTPS URL of your deployed SketchToApp AI Node.js/TypeScript backend & isolated APK build orchestrator.
# Leave as placeholder if not yet deployed; the Android app will transparently disclose worker status for remote APK compilation.
BACKEND_API_URL=https://your-sketchtoapp-backend.example.com
